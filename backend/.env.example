NODE_ENV=production
PORT=5000
BIND_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=natyyzha
DB_USER=natyyzha
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
CORS_ORIGINS=https://YOUR_DOMAIN
TRUST_CLOUDFLARE_HEADERS=false
OLLAMA_ORIGIN=http://127.0.0.1:11434
ASSISTANT_MODEL=qwen3:4b-instruct
ASSISTANT_DEBUG=0

# Optional instead of DB_* (URL-encode special characters in credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/natyyzha

# AI startup and latency; all services share one model by default.
AI_WARMUP=1
OLLAMA_KEEP_ALIVE=30m
AI_CONTEXT_TOKENS=8192
AI_CHAT_TOKENS=600
AI_STRUCTURED_TOKENS=1200
ASSISTANT_AUTO_MEMORY=0
